# Database Components
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arxiv_insight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache (Used when running natively outside docker)
REDIS_URL=redis://localhost:6379/0

# Application
DEBUG=False
ENVIRONMENT=local
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME="arXiv Insight RAG API"
CORS_ORIGINS='["*"]'

# Ingestion
ARXIV_API_URL=https://export.arxiv.org/api/query
INGESTION_RATE_LIMIT=3.1

# LLM & Embeddings
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
